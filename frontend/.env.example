# Copy to `.env.local` for local development. Real .env files are git-ignored.
#
# Every VITE_* variable is bundled into the client and is PUBLIC.
# Never put a secret here. Secrets belong in a server/serverless environment (BR-11).

# Where weather data comes from (docs/TRD.md §4a, OPEN_DECISIONS D-18).
#   live      - call the Open-Meteo API from the browser (default; no key needed)
#   snapshot  - serve recorded files from public/snapshots/ (labeled as recorded data)
# VITE_DATA_SOURCE=live

# ---- AI assistant (server side only; docs/PROVIDER_VALIDATION.md section 4, OPEN_DECISIONS D-14) ----
# None of these has a "VITE_" prefix on purpose, so they are never sent to the browser. Put real
# values in `.env.local` (git-ignored) for `npm run dev`. The assistant stays OFF unless
# ASSISTANT_ENABLED=true AND one provider below is set up.
#
# Option 1, FREE: Cloudflare Workers AI (10,000 free "neurons" a day, a few hundred questions).
# Create a free Cloudflare account, copy the Account ID from the Workers AI page ("Use REST API"),
# and create an API token from the "Workers AI" template.
#   ASSISTANT_ENABLED=true
#   CLOUDFLARE_ACCOUNT_ID=your-account-id
#   CLOUDFLARE_API_TOKEN=your-api-token
# (When deployed on Cloudflare Workers the AI binding in wrangler.jsonc is used instead: no token.)
#
# Option 2, paid: Anthropic (separate from a Claude subscription).
#   ASSISTANT_ENABLED=true
#   ANTHROPIC_API_KEY=your-key-here
#
# Optional:
#   ASSISTANT_PROVIDER=cloudflare                 # or anthropic; the free one wins if both are set
#   ASSISTANT_MODEL=@cf/google/gemma-4-26b-a4b-it # default for Cloudflare; Anthropic: claude-haiku-5-5
#   ASSISTANT_ALLOWED_ORIGINS=https://example.com # extra origins besides the site's own
#   ASSISTANT_RATE_PER_MINUTE=6                   # per visitor
#   ASSISTANT_RATE_PER_DAY=40                     # per visitor
#   ASSISTANT_DAILY_CAP=300                       # all visitors together, per running instance
