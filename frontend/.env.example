# Copy to `.env.local` for local development. Real .env files are git-ignored.
#
# Every VITE_* variable is bundled into the client and is PUBLIC.
# Never put a secret here. Secrets belong in a server/serverless environment (BR-11).
#
# No variables are required in Phase 1. Provider variables are added once the
# weather provider and key-handling approach are decided (OPEN_DECISIONS D-05, D-06).

# Public base URL of the deployed app (optional; used for absolute links later)
# VITE_APP_URL=http://localhost:5173
