{
  // Cloudflare Workers deployment (OPEN_DECISIONS D-15, candidate). NOT deployed or tested on
  // Cloudflare yet: the handler is tested in-process, and this file follows Cloudflare's
  // documented static-assets layout. Check it with `wrangler dev` before the first deploy.
  //
  // The assistant stays off until you run, from the frontend folder:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  // and set ASSISTANT_ENABLED to "true" below. Also set a monthly spend limit on the AI account
  // and add Cloudflare rate limiting for /api/assistant first (OPEN_DECISIONS D-14).
  "name": "atmos",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker for the API only; every other request is served straight from the assets.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ASSISTANT_ENABLED": "false",
  },
}
